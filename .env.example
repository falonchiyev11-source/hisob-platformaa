# Backend sozlamalari. "npm run setup" bu fayldan .env yaratadi va maxfiy kalitlarni o'zi to'ldiradi.

PORT=3000
HOST=0.0.0.0

# Do'kon vaqt mintaqasi (kun qaysi soatda tugashini belgilaydi)
APP_TIMEZONE=Asia/Tashkent

# Kirish tokeni amal qilish muddati (kun).
TOKEN_DAYS=30

# Tokenlarni imzolash uchun maxfiy kalit (kamida 32 belgi). Hech kimga bermang.
JWT_SECRET=

# --- Ma'lumotlar bazasi ---
# 1-variant: shu kompyuterning o'zida (Windows) — PostgreSQL avtomatik ishga tushadi.
LOCAL_DB=true
LOCAL_DB_PORT=54330
LOCAL_DB_PASSWORD=
# Ma'lumotlar papkasi (bo'sh bo'lsa: ../data)
DATA_DIR=./data

# 2-variant: tashqi PostgreSQL (hosting). Bunda LOCAL_DB=false qiling.
# DATABASE_URL=postgres://foydalanuvchi:parol@host:5432/savdo

# --- Frontend ---
# Frontend build papkasi (server uni o'zi ham bera oladi). Bo'sh bo'lsa: ../web/dist
# WEB_DIST=../hisob-platforma/dist
# Frontend boshqa domenda joylashsa, uning manzili (CORS uchun). Bir nechta bo'lsa vergul bilan.
# CORS_ORIGIN=https://hisob.example.uz
